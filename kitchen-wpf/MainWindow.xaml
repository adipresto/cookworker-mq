<Window x:Class="KitchenWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kitchen — order here, waiter runs it" Height="750" Width="1000">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Kitchen — order here, waiter runs it" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock x:Name="UpdatedText" Margin="12,0,0,0" Foreground="Gray" VerticalAlignment="Center"/>
            <Button x:Name="RefreshBtn" Content="Refresh (r)" Margin="12,0,0,0" Padding="8,2" Click="RefreshBtn_Click"/>
            <TextBlock x:Name="LoadingText" Text="refreshing…" Margin="8,0,0,0" Foreground="Gray" Visibility="Collapsed" VerticalAlignment="Center"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <GroupBox Header="QUEUES" Grid.Column="0" Grid.Row="0" Margin="0,0,4,4">
                <TextBlock x:Name="QueuesText" FontFamily="Consolas"/>
            </GroupBox>
            <GroupBox Header="COOKS" Grid.Column="1" Grid.Row="0" Margin="4,0,0,4">
                <StackPanel>
                    <TextBlock x:Name="DeployText" FontFamily="Consolas"/>
                    <ListBox x:Name="CooksList" Height="80" FontFamily="Consolas"/>
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Kill (x)" Click="Kill_Click" Margin="0,0,4,0"/>
                        <Button Content="Kill all (X)" Click="KillAll_Click" Margin="0,0,4,0"/>
                        <Button Content="+ Scale" Click="ScaleUp_Click" Margin="0,0,4,0"/>
                        <Button Content="- Scale" Click="ScaleDown_Click" Margin="0,0,4,0"/>
                        <Button Content="Restart (R)" Click="Restart_Click"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="ORDERS — waiting / cooking / ready" Grid.Column="0" Grid.Row="1" Margin="0,0,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0"><TextBlock Text="WAITING (orders Ready)" FontWeight="Bold"/><ListBox x:Name="WaitingList" FontFamily="Consolas" Height="110"/></StackPanel>
                    <StackPanel Grid.Row="1"><TextBlock Text="COOKING (orders Unacked)" FontWeight="Bold"/><ListBox x:Name="CookingList" FontFamily="Consolas" Height="110"/></StackPanel>
                    <StackPanel Grid.Row="2"><TextBlock Text="READY FOR WAITER (done Ready)" FontWeight="Bold"/><ListBox x:Name="ReadyList" FontFamily="Consolas" Height="110"/></StackPanel>
                </Grid>
            </GroupBox>
            <StackPanel Grid.Column="1" Grid.Row="1" Margin="4,0,0,4">
                <GroupBox Header="ALERTS — notify-tui (menu.86 / shop.close)">
                    <ListBox x:Name="AlertsList" FontFamily="Consolas" Height="100"/>
                </GroupBox>
                <GroupBox Header="WAITER" Margin="0,4,0,0">
                    <TextBlock x:Name="WaiterText" FontFamily="Consolas" TextWrapping="Wrap" MaxHeight="220"/>
                </GroupBox>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,4">
            <TextBox x:Name="OrderBox" Width="350" Margin="0,0,8,0" ToolTip="mie ayam…"/>
            <Button Content="Order" Click="Order_Click" Padding="12,2" Margin="0,0,4,0"/>
            <Button Content="Menu (A)" Click="Menu_Click" Margin="0,0,4,0"/>
            <Button Content="Alarm (N)" Click="Alarm_Click"/>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="NoticeText" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ErrorText" Foreground="Red" TextWrapping="Wrap"/>
            <TextBlock Text="o order · A/N broadcast · x kill · X kill all · +/- scale · R restart · r refresh" Foreground="Gray"/>
        </StackPanel>
    </Grid>
</Window>
