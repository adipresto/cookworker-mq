# Copy to .env and adjust to your machine. Real process env always wins.
# After a WSL restart, re-run .\deploy.ps1 — it refreshes MANAGER_URL for you.

# Broker (Docker Desktop; WSL reaches it via the gateway IP).
AMQP_URL=amqp://guest:guest@172.28.144.1:5672/
RABBIT_API=http://localhost:15672
RABBIT_USER=guest
RABBIT_PASS=guest

# Manager (k3s NodePort 30080 on the WSL node IP — dynamic, run
# `wsl -d NixOS -- hostname -I` and take the first address).
MANAGER_URL=http://172.28.151.33:30080

# Queues (contract names, rarely change).
REQUESTS_QUEUE=requests
ORDERS_QUEUE=orders
DONE_QUEUE=done

# Local role when running the binary on Windows (in-cluster comes from k8s/*.yaml).
ROLE=cook

# Waiter pace (Go durations).
REGISTER_TIME=3s
HANDOFF_TIME=2s
SERVE_TIME=5s
RETURN_TIME=3s

# Load test (off unless ORDER_EVERY set).
# ORDER_EVERY=10s
# ORDER=nasi goreng

# Manager service (in-cluster reads ServiceAccount; K8S_SERVER is local fallback).
NAMESPACE=kitchen
MANAGER_ADDR=:8080
# K8S_SERVER=https://127.0.0.1:6443
